ANTHROPIC_API_KEY=
# The model EVERY bot answers with (2026-09-14). Until then each bot's JSON named
# its own and this line did nothing; now no bot does, so this decides. Leave it
# unset for the code default, claude-haiku-4-5. A value copied here from an older
# copy of this file (it used to say claude-sonnet-5) would quietly win.
ANTHROPIC_MODEL=claude-haiku-4-5

# Voice-note transcription (task 36). Leave it empty rather than deleting the
# line: an undeclared key with a value in .env stops the service from starting.
OPENAI_API_KEY=
# Which model listens. Optional; the default is whisper-1. Worth changing if a
# real-phone run shows it mangling a sentence that switches between English,
# Malay and Chinese -- that is the one thing no test here can check.
TRANSCRIPTION_MODEL=whisper-1

WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_DAILY_MSG_LIMIT=100

# The published Flow that asks for a name, a date and a property (task 24). Get
# the id from WhatsApp Manager -> Flows after pasting the JSON in
# docs/whatsapp-flows.md. Empty is a supported state, not a broken one: the bot
# asks the same three questions in the chat instead, which is also what the web
# chat line always gets.
WHATSAPP_FLOW_ID=
# "draft" while the Flow is unpublished -- only the Meta app's own owner can
# open one of those, which is how you try it on your own phone first. It MUST go
# back to "published" once the Flow is live: Meta rejects `draft` for a
# published Flow, and the form then fails to open for everyone.
WHATSAPP_FLOW_MODE=published

# How long a conversation a colleague took over stays theirs after they stop
# doing anything (task 20). Optional; the default is two hours. Every reply they
# send puts the clock back, so this is the wait after the last one -- the bot
# takes the conversation back only once nobody has touched it for this long.
# Set it to 60 while rehearsing if you want to watch it happen; set it higher
# for a desk that leaves conversations open over lunch. Takes effect on
# `docker compose restart backend`, no deploy needed.
HANDOVER_IDLE_SECONDS=7200

# Where customer profiles are kept. Set by both compose files; leave it unset
# and the service keeps profiles in memory, losing them on every restart.
# On the VPS this is the shared infra_redis, db 16 (crm_os holds 0-4, erp_os
# 5-11), reachable only from the data_net network.
REDIS_URL=

# The audit log: every message, tool call and token bill, kept past the seven
# days a Redis profile lives and past the 200 events the console holds. Leave it
# unset and the log is simply off -- the demo runs exactly as before, keeping no
# transcript. On the VPS this is the shared infra_mysql on data_net, with a
# database and user of its own (see tasks/todo.md task 37 for the grant).
# Percent-encode the password: a raw @ or / in it will not survive the URL.
# Shape: mysql://ai_chatbot_app:PASSWORD@infra_mysql:3306/ai_chatbot
MYSQL_URL=

# The property and food demos' own back office (task 22): a second database on
# the same infra_mysql, separate from the audit log's because it holds demo state
# that wants truncating between showings rather than a record kept on purpose.
# Leave it unset and those two verticals simply have no back office -- and unlike
# the audit log, that is not silent: the first call raises and says so.
# On the VPS, one grant creates it for the account that already exists:
#   CREATE DATABASE ai_chatbot_verticals
#     CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
#   GRANT ALL PRIVILEGES ON `ai_chatbot_verticals`.* TO 'ai_chatbot_app'@'%';
#   FLUSH PRIVILEGES;
# Percent-encode the password: a raw @ or / in it will not survive the URL.
# Shape: mysql://ai_chatbot_app:PASSWORD@infra_mysql:3306/ai_chatbot_verticals
VERTICALS_MYSQL_URL=

# Guards everything under /console -- the live tool feed and the audit log's
# read endpoints. UNSET MEANS CLOSED (503), not open: that side serves every
# customer's transcript and real ERP order data, so forgetting this line should
# cost a feature rather than leak one. Any long random string: openssl rand -hex 24
CONSOLE_TOKEN=


# Back-office accounts the retail tools log in with. Required -- without them the
# ERP/CRM tools return "could not be checked" and log which variable is missing.
# Never commit real values: this repository is public.
ERP_BASE_URL=https://erp.kelvinpeng.com
ERP_EMAIL=
ERP_PASSWORD=

CRM_BASE_URL=https://crm.kelvinpeng.com
CRM_EMAIL=
CRM_PASSWORD=

# Shared secret checked on POST /internal/whatsapp/inbound — must match the same
# value configured on the whatsapp_gateway service that calls this endpoint.
INTERNAL_SHARED_SECRET=

# Required for the director's console (/console) to work at all. The page passes
# it to GET /console/stream as ?token=..., because EventSource cannot set
# headers. Leave it empty and the stream answers 503 to everyone, which is the
# safe state: that feed carries live ERP orders and customer records, and nginx
# now forwards it. Any long random string will do.
CONSOLE_TOKEN=
